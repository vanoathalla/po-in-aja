APP_NAME="PO-in Aja"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://po-in-aja.koyeb.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ==============================================================================
# SUPABASE POSTGRESQL CLOUD DATABASE CONFIGURATION
# ==============================================================================
# Gunakan Session Pooler (port 5432) atau Transaction Pooler (port 6543) dari dashboard Supabase:
# Settings -> Database -> Connection string -> URI / Parameters
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_SSLMODE=require

# ==============================================================================
# DRIVER SESSION & CACHE UNTUK CONTAINER EPHEMERAL (KOYEB / RENDER FREE TIER)
# ==============================================================================
# Wajib gunakan database agar session admin & keranjang tidak hilang saat container restart
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=poinaja_cache_

QUEUE_CONNECTION=database

# ==============================================================================
# SUPABASE STORAGE (S3 COMPATIBLE STORAGE API)
# ==============================================================================
# Dapatkan Access Key & Secret Key dari:
# Supabase Dashboard -> Storage Settings -> S3 Access Keys -> New Key
# Bikin Bucket bernama "po-in-aja" (atur Public jika ingin URL langsung bisa diakses)
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=YOUR_SUPABASE_S3_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SUPABASE_S3_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=po-in-aja
AWS_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# ==============================================================================
# MAIL NOTIFICATIONS (OPSIONAL: RESEND / MAILTRAP)
# ==============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="halo@po-in-aja.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# VITE & ASSETS
# ==============================================================================
VITE_APP_NAME="${APP_NAME}"
